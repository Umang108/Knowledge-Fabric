# Copy to .env and fill in. Never commit .env.

# ---------- Application ----------
APP_NAME=TCS Knowledge Fabric API
LOG_LEVEL=INFO
CSRF_HEADER=X-Requested-With
CSRF_VALUE=graphbase

# ---------- Postgres ----------
POSTGRES_DB=graphbase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Native PostgreSQL port used when running Uvicorn directly.
POSTGRES_PORT=5432
# Compose host port only (inside Docker the backend uses postgres:5432)
POSTGRES_HOST_PORT=5433
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
# Keep stable unless you are deliberately coordinating a new deployment lock namespace.
POSTGRES_MIGRATION_LOCK=72011001
HEALTH_CHECK_TIMEOUT_SECONDS=3
STARTUP_WARNING_LIMIT=10

# ---------- Neo4j ----------
NEO4J_USER=neo4j
# Neo4j 5 rejects "neo4j" as a password and needs >= 8 characters
NEO4J_PASSWORD=neo4j123
# single = Community, all KBs in one database isolated by a per-KB label
# multi  = Enterprise, one Neo4j database per KB
NEO4J_MODE=single
NEO4J_POOL_SIZE=20
NEO4J_READ_LIMIT=200
NEO4J_READ_TIMEOUT_SECONDS=30
NEO4J_WRITE_BATCH_SIZE=1000
NEO4J_IMAGE=neo4j:5-community
# Set to "yes" only when using the enterprise image and you hold a licence
NEO4J_ACCEPT_LICENSE=no
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m
# Host ports (change if taken; containers talk to each other on their internal ports)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- Vector store (TurboQuant) ----------
# Document knowledge bases are stored as TurboQuant index files (one per knowledge base) plus the chunk text in
# Postgres. No separate server. The backend and the MCP server must use the same folder.
# Default: backend/data/vectors. Docker Compose uses the "vectors" volume.
# VECTOR_DIR=/srv/tcs-knowledge-fabric/vectors
# Bits per coordinate for new indexes: 4 (most accurate), 3 or 2 (smallest)
TURBOQUANT_BITS=4
VECTOR_INDEX_SUFFIX=.tvim
VECTOR_LOCK_NAMESPACE=72011002

# ---------- LLM / embeddings ----------
# ollama | azure
LLM_PROVIDER=azure
# Where the backend container finds Ollama:
#  - host Ollama bound to 127.0.0.1 (Linux): enable the ollama-proxy profile below and use :11435
#  - host Ollama bound to 0.0.0.0, or Docker Desktop: http://host.docker.internal:11434
#  - Ollama in Compose (profile "ollama"): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window and per-call timeout for the local model
OLLAMA_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=600
# Send every sheet header and row to Azure in bounded chunks during extraction.
FULL_SHEET_LLM_ANALYSIS=true
MAX_LLM_ROWS=500
MAX_LLM_CHARS=120000

# Azure OpenAI (used only when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# ---------- Auth ----------
# local = user ID + password checked by the backend | keycloak = sign-in through Keycloak (run by the backend)
AUTH_PROVIDER=local
# Encrypts the Keycloak tokens kept in server-side sessions: openssl rand -hex 32
SECRET_KEY=generate-a-long-random-string
# Sessions are server-side; the browser only gets an HttpOnly cookie.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# true when the app is served over https
SESSION_COOKIE_SECURE=false
# Browser-facing address of the app; Keycloak redirects back to APP_URL/api/auth/callback
APP_URL=http://localhost:5173

# Browser-facing Keycloak URL (token issuer is ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM})
KEYCLOAK_URL=http://localhost:8080
# URL the backend container uses to talk to Keycloak (token exchange, keys, logout)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=graphbase
KEYCLOAK_CLIENT_ID=graphbase-app
# Only for a confidential client; leave blank for a public client (PKCE is always used)
KEYCLOAK_CLIENT_SECRET=

# Local Keycloak container (profile "keycloak") admin console login
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Only needed when the browser loads the frontend from a different origin than the API (no Vite/nginx
# proxy in front). Comma-separated exact origins, e.g. http://10.138.77.117:10006. "*" is ignored.
CORS_ORIGINS=

# ---------- Chat guardrails (app/guardrails.py) ----------
# Mask PII in answers and query results at or above this NIST SP 800-122 impact level: none | low | moderate | high
GUARDRAIL_MASK_PII=high
# Documents: answer "not found" when no passage reaches this relevance (0-1; 0 = off)
GUARDRAIL_MIN_RELEVANCE=0
# Extra model-based screening of questions (one more LLM call per question)
GUARDRAIL_LLM_CHECK=false
GUARDRAIL_MAX_QUESTION_CHARS=2000

# ---------- RAG processing ----------
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_BATCH_SIZE=32
RAG_RETRIEVAL_TOP_K=6

# ---------- Langfuse tracing (optional; off while the keys are empty) ----------
# One trace per user operation: Chat / RAG Chat, KG Extraction, KG Build, Embedding, Add Data, MCP <tool>.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud; use https://us.cloud.langfuse.com for a US project, or your self-hosted URL (Langfuse v3 server)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# e.g. dev / prod, to tell traces apart in one project
LANGFUSE_ENVIRONMENT=
# false = send timings, models and token usage only (no prompts/answers, e.g. when data contains PII)
LANGFUSE_CAPTURE_CONTENT=true
# Longer prompt/answer text is trimmed in traces (oversized exports are rejected as a whole)
LANGFUSE_MAX_FIELD_CHARS=10000
# Background export: spans per batch, seconds between batches, seconds per request
LANGFUSE_FLUSH_AT=50
LANGFUSE_FLUSH_INTERVAL=2
LANGFUSE_TIMEOUT=20

# ---------- MCP server (agents) ----------
# `python -m app.mcp_server` (compose service "mcp"). Agents send a Keycloak access token as Bearer.
MCP_PORT=8100
MCP_HOST_PORT=8100
# How agents reach it (no /mcp suffix); also advertised in /.well-known/oauth-protected-resource/mcp
MCP_PUBLIC_URL=http://localhost:8100
# Must appear in the token's "aud" claim (audience mapper on the agent client, see keycloak/graphbase-realm.json)
MCP_AUDIENCE=graphbase-mcp
# Comma-separated scopes every token must carry (blank = none required)
MCP_REQUIRED_SCOPES=
# Create the users row the first time a Keycloak user calls the MCP server
MCP_AUTO_PROVISION_USERS=true
MCP_MAX_ROWS=200

# ---------- Agent CLI (agent/, runs on the user's machine) ----------
GRAPHBASE_MCP_URL=http://localhost:8100/mcp
AGENT_CLIENT_ID=graphbase-agent
# Only for a confidential agent client
AGENT_CLIENT_SECRET=
AGENT_SCOPE=openid
# CA file when Keycloak / the MCP server use an internal certificate authority
KEYCLOAK_CA_BUNDLE=

# ---------- SAP / ServiceNow connectors ----------
# Comma-separated host patterns the backend may connect to (fnmatch, e.g. *.service-now.com,s4.corp.local).
# Blank = any host. Set it in production so saved connections can't be pointed at internal services.
CONNECTOR_ALLOWED_HOSTS=
# CA bundle for source systems signed by an internal CA (TLS verification stays on)
CONNECTOR_CA_BUNDLE=

# ---------- Compose profiles ----------
# Comma-separated optional services to start with `docker compose up`: ollama-proxy, ollama, keycloak
COMPOSE_PROFILES=ollama-proxy

# ---------- Ports ----------
# Host ports only. The frontend reaches the backend inside Docker, so these can be any free ports.
# If you change FRONTEND_PORT, also update APP_URL (and the Keycloak redirect URI).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------- RAG evaluation (python -m app.cli eval-rag) ----------
# Judge model for RAGAS; empty = the app's own chat / embedding model
# RAGAS_JUDGE_MODEL=
# RAGAS_JUDGE_EMBED_MODEL=
# RAGAS_REPORT_DIR=/srv/tcs-knowledge-fabric/reports/ragas
RAGAS_METRIC_TIMEOUT_SECONDS=300
RAGAS_JUDGE_MAX_TOKENS=4096
RAGAS_DEFAULT_CONCURRENCY=4

# ---------- Data processing ----------
UPLOAD_MAX_MB=50
TABULAR_HEADER_SCAN_ROWS=15
LOADER_MAX_REPORTED_REJECTIONS=5000
CONNECTOR_MAX_ROWS=50000
CONNECTOR_TIMEOUT_SECONDS=60
CONNECTOR_CONNECT_TIMEOUT_SECONDS=15
EXTRACTION_MAX_ROWS_TO_LLM=60
CHAT_MAX_ROWS_TO_LLM=60
CHAT_MAX_PATH_ROWS=20
CHAT_PROMPT_RESULT_LIMIT=50
CHAT_HISTORY_MAX_CHARS=2000
EXTRACTION_FIXPOINT_MAX_ITERATIONS=10
JOB_ERROR_MAX_CHARS=2000
CONVERSATION_RETENTION_COUNT=10
CONVERSATION_HISTORY_TURNS=5
AUTH_DEFAULT_TOKEN_EXPIRY_SECONDS=300

# ---------- Authentication/network timeouts ----------
AUTH_LAST_SEEN_RESOLUTION_SECONDS=60
AUTH_LOGIN_REQUEST_TTL_MINUTES=10
KEYCLOAK_JWKS_CACHE_SECONDS=3600
KEYCLOAK_TOKEN_TIMEOUT_SECONDS=15
KEYCLOAK_LOGOUT_TIMEOUT_SECONDS=10
